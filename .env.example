# Copie este arquivo para ".env" e preencha com os seus valores.
# O arquivo ".env" nunca deve ser commitado (já está no .gitignore).

# ----------------------------------------------------------------- banco ----
# String de conexão do PostgreSQL.
# O valor abaixo já funciona com o banco do docker-compose.yml (docker compose up -d).
# Usa outro PostgreSQL ou outra porta? Ajuste a URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/easyfood"

# Opcional. Banco "sombra" usado por `npm run prisma:check`, que compara as
# migrations com o schema.prisma. Precisa ser um banco vazio e descartável.
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/easyfood_shadow"

# ------------------------------------------------------------------- API ----
# Porta em que a API vai subir (opcional, padrão 3000)
PORT=3000

# OBRIGATÓRIA. Chave usada para assinar e validar os tokens JWT.
# Precisa ter no mínimo 32 bytes — a aplicação se recusa a subir com menos.
# Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Opcional. Validade do token (padrão: 1d). Aceita o formato do jsonwebtoken.
# JWT_EXPIRES_IN=1d

# Opcional. Cookie do token (ADR-006): exige HTTPS quando "true". Liga
# sozinho quando NODE_ENV=production; em desenvolvimento local (http)
# precisa continuar false, senão o navegador nunca envia o cookie de volta.
# COOKIE_SECURE=false

# --------------------------------------------------------- documentação ----
# Opcional. Liga/desliga a documentação da API em /docs (Swagger UI) e
# /docs.json (padrão: true). Pode desligar em produção com "false".
# API_DOCS_ENABLED=true

# --------------------------------------------------------------- limites ----
# Opcional. Tamanho máximo do corpo de uma requisição (padrão: 100kb).
# BODY_LIMIT=100kb

# Opcional. Rate limit das rotas /auth (padrão: 20 requisições a cada 15 min).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=20

# ------------------------------------------------------------ deploy ----
# Opcional. Quantos proxies confiáveis existem à frente da API (Render, Railway,
# Fly, Nginx...). Atrás de um proxy, sem isso o limite de tentativas de /auth
# conta todos os usuários como um só. Em desenvolvimento local, deixe vazio.
# Aceita um número (1, 2...) ou uma lista de sub-redes. "true" não é aceito.
# TRUST_PROXY=1

# Opcional. Origens autorizadas a chamar a API a partir de outro site (CORS),
# separadas por vírgula, sem barra no final. Vazio: fora de produção libera
# qualquer origem; em produção não envia cabeçalhos CORS (só a mesma origem).
# CORS_ORIGIN=https://easyfood.exemplo.com

# ---------------------------------------------------------------- seed ----
# Opcional. Cria o usuário de demonstração (demo@easyfood.local / easyfood123)
# ao rodar `npm run prisma:seed`. A senha é pública: use só em desenvolvimento.
# Nunca é criado com NODE_ENV=production.
# SEED_DEMO_USER=true

# --------------------------------------------------- notificações (ADR-005) --
# Opcional. Liga/desliga a simulação de e-mail e aviso ao comercial (padrão: true).
# Nada é enviado de verdade: as ações são registradas no log do servidor.
# NOTIFICATIONS_ENABLED=true

# Opcional. Destinatário do aviso ao time comercial.
# O padrão usa o domínio reservado ".example", que não existe na internet.
# COMMERCIAL_EMAIL=comercial@easyfood.example

# Opcional. LOG_LEVEL=silent desliga o log da aplicação (usado nos testes).
# LOG_LEVEL=
